# CryptoBank Environment Configuration
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# Production PostgreSQL Database Settings (active when SPRING_PROFILES_ACTIVE=prod)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cryptobank?sslmode=disable
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Google Gemini AI Integration (Google AI Studio Key)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
